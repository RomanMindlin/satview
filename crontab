SHELL=/bin/sh
PATH=/app/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Output goes to the container's stdout, so `docker logs satview` shows it.
# flock: a slow run is not started again on top of itself.
20 * * * * root cd /app && flock -n /tmp/satview.lock satview run >> /proc/1/fd/1 2>&1
45 * * * * root cd /app && python telegram_sender.py output/israel_north >> /proc/1/fd/1 2>&1
# raw downloads (~3 GB a day) older than output.keep_raw_days
0 3 * * * root cd /app && flock /tmp/satview.lock satview clean >> /proc/1/fd/1 2>&1
