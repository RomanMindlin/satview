# Filled in from GitHub secrets by .github/workflows/deploy.yml (envsubst)

# EUMETSAT Data Store (meteosat12_fci, meteosat9_iodc)
EUMETSAT_KEY=${EUMETSAT_KEY}
EUMETSAT_SECRET=${EUMETSAT_SECRET}

# NASA Earthdata (viirs_l1b): a token, or username + password
EARTHDATA_TOKEN=${EARTHDATA_TOKEN}
EARTHDATA_USERNAME=${EARTHDATA_USERNAME}
EARTHDATA_PASSWORD=${EARTHDATA_PASSWORD}

# Copernicus Data Space (sentinel3_olci)
CDSE_USER=${CDSE_USER}
CDSE_PASSWORD=${CDSE_PASSWORD}

# Telegram (telegram_sender.py)
TG_BOT_TOKEN=${TG_BOT_TOKEN}
TG_CHANNEL_ID=${TG_CHANNEL_ID}
