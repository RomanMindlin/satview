# Copy to .env and fill in. Never commit .env.

# EUMETSAT Data Store (meteosat12_fci, meteosat9_iodc): https://api.eumetsat.int/api-key/
EUMETSAT_KEY=
EUMETSAT_SECRET=

# NASA Earthdata (viirs_l1b): a token, or username + password
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Copernicus Data Space (sentinel3_olci)
CDSE_USER=
CDSE_PASSWORD=
